		return
	}
	// Negative logical height gives character height in pixels close to requested size.
	f, _, _ := procCreateFontW.Call(uintptr(^uint32(size*4/3-1)), 0, 0, 0, uintptr(weight), 0, 0, 0, 1, 0, 0, 5, 0, uintptr(unsafe.Pointer(wstr(face))))
	old, _, _ := procSelectObject.Call(hdc, f)
	procSetBkMode.Call(hdc, TRANSPARENT)
	procSetTextColor.Call(hdc, color)
	rc := RECT{l, t, r, b}
	p := syscall.StringToUTF16(s)
	if len(p) > 0 {
		procDrawTextW.Call(hdc, uintptr(unsafe.Pointer(&p[0])), uintptr(len(p)-1), uintptr(unsafe.Pointer(&rc)), uintptr(flags))
	}
	procSelectObject.Call(hdc, old)
	procDeleteObject.Call(f)
}

func makeIcon() uintptr {
	// 32x32 monochrome-ish luxury icon: dark square with bright $ glyph is difficult without GDI bitmap drawing;
	// create a clean geometric cyan/gold icon bitmap via direct BGRA pixels.
	const n = 32
	pixels := make([]byte, n*n*4)
	for y := 0; y < n; y++ {
		for x := 0; x < n; x++ {
			i := (y*n + x) * 4
			dx := x - 16
			dy := y - 16
			dist := dx*dx + dy*dy
			if dist < 225 {
				pixels[i+0] = 36
				pixels[i+1] = 31
				pixels[i+2] = 24
				pixels[i+3] = 255
			} else {
				pixels[i+0] = 18
				pixels[i+1] = 14
				pixels[i+2] = 10
				pixels[i+3] = 255
			}
			// stylized vertical MX stroke / dollar line
			if (x >= 14 && x <= 17 && y >= 6 && y <= 26) || (y >= 9 && y <= 12 && x >= 10 && x <= 22) || (y >= 19 && y <= 22 && x >= 10 && x <= 22) {
				pixels[i+0] = 118
				pixels[i+1] = 197
				pixels[i+2] = 229
				pixels[i+3] = 255
			}
		}
	}
	color, _, _ := procCreateBitmap.Call(n, n, 1, 32, uintptr(unsafe.Pointer(&pixels[0])))
	maskBits := make([]byte, n*n/8)
	mask, _, _ := procCreateBitmap.Call(n, n, 1, 1, uintptr(unsafe.Pointer(&maskBits[0])))
	ii := ICONINFO{FIcon: 1, HbmMask: mask, HbmColor: color}
	icon, _, _ := procCreateIconIndirect.Call(uintptr(unsafe.Pointer(&ii)))
	procDeleteObject.Call(color)
	procDeleteObject.Call(mask)
	return icon
}

func addTray() {
	var n NOTIFYICONDATA
	n.CbSize = uint32(unsafe.Sizeof(n))
	n.HWnd = hwnd
	n.UID = 1
	n.UFlags = NIF_MESSAGE | NIF_ICON | NIF_TIP
	n.UCallbackMessage = WM_TRAY
	n.HIcon = appIcon
	copyUTF16(n.SzTip[:], "MX Dollar")
	procShellNotifyIconW.Call(NIM_ADD, uintptr(unsafe.Pointer(&n)))
	updateTrayTip()
}
func removeTray() {
	var n NOTIFYICONDATA
	n.CbSize = uint32(unsafe.Sizeof(n))
	n.HWnd = hwnd
	n.UID = 1
	procShellNotifyIconW.Call(NIM_DELETE, uintptr(unsafe.Pointer(&n)))
}
func updateTrayTip() {
	mu.RLock()
	d := data
	mu.RUnlock()
	hi := maxInt(d.Kifah.Sell, d.Harithiya.Sell)
	tip := "MX Dollar"
	if hi > 0 {
		tip = fmtIQD(hi)
	}
	var n NOTIFYICONDATA
	n.CbSize = uint32(unsafe.Sizeof(n))
	n.HWnd = hwnd
	n.UID = 1
	n.UFlags = NIF_TIP
	copyUTF16(n.SzTip[:], tip)
	procShellNotifyIconW.Call(NIM_MODIFY, uintptr(unsafe.Pointer(&n)))
}
func notify(title, body string) {
	var n NOTIFYICONDATA
	n.CbSize = uint32(unsafe.Sizeof(n))
	n.HWnd = hwnd
	n.UID = 1
	n.UFlags = NIF_INFO
	copyUTF16(n.SzInfoTitle[:], title)
	copyUTF16(n.SzInfo[:], body)
	n.DwInfoFlags = NIIF_INFO
	procShellNotifyIconW.Call(NIM_MODIFY, uintptr(unsafe.Pointer(&n)))
}

func showMenu() {
	menu, _, _ := procCreatePopupMenu.Call()
	defer procDestroyMenu.Call(menu)
	procAppendMenuW.Call(menu, MF_STRING, ID_TRAY_OPEN, uintptr(unsafe.Pointer(wstr("فتح MX Dollar"))))
	procAppendMenuW.Call(menu, MF_STRING, ID_TRAY_REFRESH, uintptr(unsafe.Pointer(wstr("تحديث الأسعار"))))
	mu.RLock()
	ua := updateAvailable
	ub := updatingApp
	uv := updateInfo.Version
	mu.RUnlock()
	if ua && !ub {
		procAppendMenuW.Call(menu, MF_STRING, ID_TRAY_APP_UPDATE, uintptr(unsafe.Pointer(wstr("تحديث MX Dollar إلى v"+uv))))
	} else {
		procAppendMenuW.Call(menu, MF_STRING, ID_TRAY_CHECK_UPDATE, uintptr(unsafe.Pointer(wstr("فحص تحديث البرنامج"))))
	}
	procAppendMenuW.Call(menu, MF_STRING, ID_TRAY_EXIT, uintptr(unsafe.Pointer(wstr("خروج"))))
	var pt POINT
	procGetCursorPos.Call(uintptr(unsafe.Pointer(&pt)))
	procSetForegroundWindow.Call(hwnd)
	cmd, _, _ := procTrackPopupMenu.Call(menu, TPM_RIGHTBUTTON|TPM_RETURNCMD, uintptr(pt.X), uintptr(pt.Y), 0, hwnd, 0)
	switch cmd {
	case ID_TRAY_OPEN:
		showMain()
	case ID_TRAY_REFRESH:
		requestRefresh(true)
	case ID_TRAY_CHECK_UPDATE:
		requestUpdateCheck()
	case ID_TRAY_APP_UPDATE:
		beginSelfUpdate()
	case ID_TRAY_EXIT:
		exiting = true
		removeTray()
		procPostQuitMessage.Call(0)
	}
}
func showMain() {
	procShowWindow.Call(hwnd, SW_RESTORE)
	procShowWindow.Call(hwnd, SW_SHOWNORMAL)
	procSetForegroundWindow.Call(hwnd)
}
func openURL(url string) {
	procShellExecuteW.Call(0, uintptr(unsafe.Pointer(wstr("open"))), uintptr(unsafe.Pointer(wstr(url))), 0, 0, SW_SHOWNORMAL)
}

func enableStartup() {
	exe, err := os.Executable()
	if err != nil {
		return
	}
	sub := wstr("Software\\Microsoft\\Windows\\CurrentVersion\\Run")
	var key uintptr
	const HKEY_CURRENT_USER = 0x80000001
	r, _, _ := procRegCreateKeyExW.Call(HKEY_CURRENT_USER, uintptr(unsafe.Pointer(sub)), 0, 0, 0, 0x0002, 0, uintptr(unsafe.Pointer(&key)), 0)
	if r != 0 {
		return
	}
	defer procRegCloseKey.Call(key)
	val := syscall.StringToUTF16("\"" + exe + "\" --startup")
	procRegSetValueExW.Call(key, uintptr(unsafe.Pointer(wstr("MX Dollar"))), 0, 1, uintptr(unsafe.Pointer(&val[0])), uintptr(len(val)*2))
}

func requestRefresh(manual bool) {
	mu.Lock()
	if refreshing {
		mu.Unlock()
		return
	}
	refreshing = true
	mu.Unlock()
	procInvalidateRect.Call(hwnd, 0, 1)
	go refreshWorker(manual)
}
func refreshWorker(manual bool) {
	nd, err := fetchMarkets()
	mu.Lock()
	old := data
	if err == nil {
		lastData = old
		data = nd
		data.Error = ""
		saveCacheLocked()
	} else {
		data.Error = err.Error()
		data.Updated = time.Now()
	}
	refreshing = false
	cur := data
	mu.Unlock()
	if err == nil {
		maybeNotify(old, cur, manual)
	}
	procPostMessageW.Call(hwnd, WM_DATA_READY, 0, 0)
}

func maybeNotify(old, cur MarketData, manual bool) {
	oldHigh := maxInt(old.Kifah.Sell, old.Harithiya.Sell)
	newHigh := maxInt(cur.Kifah.Sell, cur.Harithiya.Sell)
	if oldHigh > 0 && newHigh > 0 && oldHigh != newHigh {
		arrow := "▲"
		verb := "صعد"
		if newHigh < oldHigh {
			arrow = "▼"
			verb = "نزل"
		}
		notify("MX Dollar · "+arrow, fmt.Sprintf("الدولار %s إلى %s د.ع لكل 100$", verb, fmtIQD(newHigh)))
	} else if manual {
		notify("MX Dollar", "تم تحديث الأسعار بنجاح")
	}
	if old.Gold.K21 > 0 && cur.Gold.K21 > 0 && old.Gold.K21 != cur.Gold.K21 {
		diff := cur.Gold.K21 - old.Gold.K21
		if abs(diff) >= 1000 {
			arrow := "▲"
			if diff < 0 {
				arrow = "▼"
			}
			notify("ذهب 21K · "+arrow, fmt.Sprintf("المثقال الآن %s د.ع", fmtIQD(cur.Gold.K21)))
		}
	}
}

func requestUpdateCheck() {
	mu.Lock()
	if checkingUpdate || updatingApp {
		mu.Unlock()
		return
