	}
	checkingUpdate = true
	updateStatus = "جاري فحص التحديث..."
	mu.Unlock()
	procInvalidateRect.Call(hwnd, 0, 1)
	go func() {
		m, err := fetchUpdateManifest()
		mu.Lock()
		checkingUpdate = false
		if err != nil {
			updateAvailable = false
			updateStatus = "تعذر فحص التحديث"
		} else if compareVersion(m.Version, appVersion) > 0 {
			updateInfo = m
			updateAvailable = true
			updateStatus = "تحديث جديد متوفر"
		} else {
			updateInfo = m
			updateAvailable = false
			updateStatus = "البرنامج محدّث"
		}
		mu.Unlock()
		procPostMessageW.Call(hwnd, WM_UPDATE_READY, 0, 0)
	}()
}

func fetchUpdateManifest() (UpdateManifest, error) {
	var m UpdateManifest
	client := &http.Client{Timeout: 12 * time.Second}
	req, _ := http.NewRequest("GET", updateManifestURL+"?t="+strconv.FormatInt(time.Now().Unix(), 10), nil)
	req.Header.Set("User-Agent", "MX-Dollar/"+appVersion)
	res, err := client.Do(req)
	if err != nil {
		return m, err
	}
	defer res.Body.Close()
	if res.StatusCode != http.StatusOK {
		return m, fmt.Errorf("update HTTP %d", res.StatusCode)
	}
	b, err := io.ReadAll(io.LimitReader(res.Body, 128<<10))
	if err != nil {
		return m, err
	}
	if err := json.Unmarshal(b, &m); err != nil {
		return m, err
	}
	if strings.TrimSpace(m.Version) == "" || strings.TrimSpace(m.URL) == "" || strings.TrimSpace(m.SHA256) == "" {
		return m, fmt.Errorf("update manifest incomplete")
	}
	return m, nil
}

func compareVersion(a, b string) int {
	parse := func(v string) []int {
		v = strings.TrimPrefix(strings.TrimSpace(v), "v")
		parts := strings.Split(v, ".")
		out := make([]int, 4)
		for i := 0; i < len(parts) && i < len(out); i++ {
			n, _ := strconv.Atoi(regexp.MustCompile(`[^0-9].*$`).ReplaceAllString(parts[i], ""))
			out[i] = n
		}
		return out
	}
	x, y := parse(a), parse(b)
	for i := range x {
		if x[i] > y[i] {
			return 1
		}
		if x[i] < y[i] {
			return -1
		}
	}
	return 0
}

func beginSelfUpdate() {
	mu.Lock()
	if !updateAvailable || updatingApp {
		mu.Unlock()
		return
	}
	info := updateInfo
	updatingApp = true
	updateStatus = "جاري تنزيل التحديث..."
	mu.Unlock()
	procInvalidateRect.Call(hwnd, 0, 1)
	go func() {
		script, err := downloadAndStageUpdate(info)
		if err != nil {
			mu.Lock()
			updatingApp = false
			updateStatus = "فشل التحديث — حاول مرة ثانية"
			mu.Unlock()
			notify("MX Dollar", "فشل تنزيل أو تجهيز التحديث")
			procPostMessageW.Call(hwnd, WM_UPDATE_READY, 0, 0)
			return
		}
		mu.Lock()
		pendingUpdater = script
		updateStatus = "اكتمل التنزيل — جاري إعادة التشغيل"
		mu.Unlock()
		procPostMessageW.Call(hwnd, WM_UPDATE_INSTALL, 0, 0)
	}()
}

func downloadAndStageUpdate(info UpdateManifest) (string, error) {
	exePath, err := os.Executable()
	if err != nil {
		return "", err
	}
	exePath, _ = filepath.Abs(exePath)
	tmpDir := filepath.Join(os.TempDir(), "MXDollarUpdate")
	if err := os.MkdirAll(tmpDir, 0755); err != nil {
		return "", err
	}
	newPath := filepath.Join(tmpDir, "MX Dollar new.exe")
	scriptPath := filepath.Join(tmpDir, "MX Dollar updater.cmd")

	client := &http.Client{Timeout: 90 * time.Second}
	req, _ := http.NewRequest("GET", info.URL, nil)
	req.Header.Set("User-Agent", "MX-Dollar-Updater/"+appVersion)
	res, err := client.Do(req)
	if err != nil {
		return "", err
	}
	defer res.Body.Close()
	if res.StatusCode < 200 || res.StatusCode >= 300 {
		return "", fmt.Errorf("download HTTP %d", res.StatusCode)
	}
	f, err := os.Create(newPath)
	if err != nil {
		return "", err
	}
	h := sha256.New()
	_, copyErr := io.Copy(io.MultiWriter(f, h), io.LimitReader(res.Body, 64<<20))
	closeErr := f.Close()
	if copyErr != nil {
		return "", copyErr
	}
	if closeErr != nil {
		return "", closeErr
	}
	got := strings.ToLower(hex.EncodeToString(h.Sum(nil)))
	want := strings.ToLower(strings.TrimSpace(info.SHA256))
	if got != want {
		_ = os.Remove(newPath)
		return "", fmt.Errorf("SHA256 mismatch")
	}

	pid := os.Getpid()
	// The helper waits for this process to release the EXE, replaces it, relaunches it, then removes itself.
	script := fmt.Sprintf("@echo off\r\nsetlocal\r\nset \"PID=%d\"\r\nset \"NEW=%s\"\r\nset \"OLD=%s\"\r\n:wait\r\ntasklist /FI \"PID eq %%PID%%\" /NH | findstr /C:\"%%PID%%\" >nul 2>nul\r\nif not errorlevel 1 (timeout /t 1 /nobreak >nul & goto wait)\r\nset TRY=0\r\n:replace\r\nset /a TRY+=1\r\ncopy /Y \"%%NEW%%\" \"%%OLD%%\" >nul 2>nul\r\nif errorlevel 1 (if %%TRY%% LSS 30 (timeout /t 1 /nobreak >nul & goto replace) else goto end)\r\nstart \"\" \"%%OLD%%\"\r\ndel /Q \"%%NEW%%\" >nul 2>nul\r\n:end\r\nstart \"\" /b cmd /c del \"%%~f0\" >nul 2>nul\r\n", pid, newPath, exePath)
	if err := os.WriteFile(scriptPath, []byte(script), 0644); err != nil {
		return "", err
	}
	return scriptPath, nil
}

func fetchMarkets() (MarketData, error) {
	var out MarketData
	var errs []string
	client := &http.Client{Timeout: 10 * time.Second}
	if body, err := fetchPage(client, "https://t.me/s/dollariraqi"); err == nil {
		out.Kifah, out.Harithiya = parseBaghdadMarkets(body)
	} else {
		errs = append(errs, "Baghdad")
	}
	if body, err := fetchPage(client, "https://mithqaly.com/%D8%A7%D8%B3%D8%B9%D8%A7%D8%B1-%D8%A7%D9%84%D8%B0%D9%87%D8%A8/"); err == nil {
		out.Gold = parseGold(body)
	} else {
		errs = append(errs, "Gold")
	}
	out.Updated = time.Now()
	if out.Kifah.Sell == 0 && out.Harithiya.Sell == 0 && out.Gold.K21 == 0 {
		return out, fmt.Errorf("تعذر جلب بيانات السوق")
	}
	return out, nil
}
func fetchPage(client *http.Client, url string) (string, error) {
	req, _ := http.NewRequest("GET", url, nil)
	req.Header.Set("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/152 Safari/537.36")
	req.Header.Set("Accept-Language", "ar-IQ,ar;q=0.9,en;q=0.8")
	res, err := client.Do(req)
	if err != nil {
		return "", err
	}
	defer res.Body.Close()
	if res.StatusCode < 200 || res.StatusCode >= 300 {
		return "", fmt.Errorf("HTTP %d", res.StatusCode)
	}
	b, err := io.ReadAll(io.LimitReader(res.Body, 4<<20))
	return string(b), err
}

var tagRE = regexp.MustCompile(`(?s)<[^>]*>`)
var spacesRE = regexp.MustCompile(`\s+`)

func stripHTML(s string) string {
	s = regexp.MustCompile(`(?is)<script.*?</script>|<style.*?</style>`).ReplaceAllString(s, " ")
	s = tagRE.ReplaceAllString(s, "\n")
	s = html.UnescapeString(s)
	s = strings.ReplaceAll(s, "\u200f", "")
	s = strings.ReplaceAll(s, "\u200e", "")
	return spacesRE.ReplaceAllString(s, " ")
}
func parsePrice(s string) int {
	s = strings.ReplaceAll(s, ",", "")
	s = strings.ReplaceAll(s, ".", "")
	n, _ := strconv.Atoi(strings.TrimSpace(s))
	return n
}
func parseBaghdadMarkets(body string) (Quote, Quote) {
	txt := stripHTML(body)
	parseMarket := func(name string) Quote {
		re := regexp.MustCompile(name + `\s*([0-9]{4}\.[0-9]{2})\s*\|\s*([0-9]{4}\.[0-9]{2})`)
		ms := re.FindAllStringSubmatch(txt, -1)
		q := Quote{Source: name}
		if len(ms) == 0 {
			return q
		}
		m := ms[len(ms)-1]
		wanted := parseFloatPrice(m[1])
		offered := parseFloatPrice(m[2])
		q.Buy = int(wanted*100 + 0.5)
		q.Sell = int(offered*100 + 0.5)
		return q
	}
	return parseMarket("كفاح"), parseMarket("حارثية")
}
func parseFloatPrice(s string) float64 { f, _ := strconv.ParseFloat(s, 64); return f }
