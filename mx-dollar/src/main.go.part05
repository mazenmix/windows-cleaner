func parseGold(body string) Gold {
	txt := stripHTML(body)
	get := func(k string) int {
		re := regexp.MustCompile(`مثقال ذهب عيار\s*` + k + `[^0-9]{0,60}([0-9]{2,3}(?:,[0-9]{3}){1,2})\s*د\.ع`)
		m := re.FindStringSubmatch(txt)
		if len(m) >= 2 {
			return parsePrice(m[1])
		}
		return 0
	}
	g := Gold{K21: get("21"), K24: get("24")}
	if g.K24 > 0 {
		g.K18 = int(float64(g.K24)*0.75 + 0.5)
	} else if g.K21 > 0 {
		g.K18 = int(float64(g.K21)*(18.0/21.0) + 0.5)
		g.K24 = int(float64(g.K21)*(24.0/21.0) + 0.5)
	}
	return g
}

func cacheFile() string { return filepath.Join(cachedAppDir, "cache.json") }
func loadCache() {
	b, err := os.ReadFile(cacheFile())
	if err == nil {
		_ = json.Unmarshal(b, &data)
	}
}
func saveCacheLocked() {
	b, _ := json.MarshalIndent(data, "", "  ")
	_ = os.WriteFile(cacheFile(), b, 0644)
}

func maxInt(a, b int) int {
	if a > b {
		return a
	}
	return b
}
func abs(a int) int {
	if a < 0 {
		return -a
	}
	return a
}
func fmtIQD(n int) string {
	if n <= 0 {
		return "—"
	}
	s := strconv.Itoa(n)
	for i := len(s) - 3; i > 0; i -= 3 {
		s = s[:i] + "," + s[i:]
	}
	return s
}
