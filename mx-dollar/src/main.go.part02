			procPostQuitMessage.Call(0)
			return 0
		}
		procShowWindow.Call(h, SW_HIDE)
		return 0
	case WM_DESTROY:
		removeTray()
		procKillTimer.Call(h, 1)
		procKillTimer.Call(h, 2)
		procPostQuitMessage.Call(0)
		return 0
	}
	r, _, _ := procDefWindowProcW.Call(h, uintptr(msg), wParam, lParam)
	return r
}

func inRect(x, y, l, t, r, b int32) bool { return x >= l && x <= r && y >= t && y <= b }

func paintWindow(h uintptr) {
	var ps PAINTSTRUCT
	hdc, _, _ := procBeginPaint.Call(h, uintptr(unsafe.Pointer(&ps)))
	if hdc == 0 {
		return
	}
	defer procEndPaint.Call(h, uintptr(unsafe.Pointer(&ps)))

	var rc RECT
	procGetClientRect.Call(h, uintptr(unsafe.Pointer(&rc)))
	w := int(rc.Right - rc.Left)
	hh := int(rc.Bottom - rc.Top)
	mem, _, _ := procCreateCompatibleDC.Call(hdc)
	bmp, _, _ := procCreateCompatibleBitmap.Call(hdc, uintptr(w), uintptr(hh))
	oldBmp, _, _ := procSelectObject.Call(mem, bmp)
	defer func() { procSelectObject.Call(mem, oldBmp); procDeleteObject.Call(bmp); procDeleteDC.Call(mem) }()

	// Background
	fill(mem, 0, 0, int32(w), int32(hh), rgb(10, 14, 20))
	// Header
	fill(mem, 0, 0, int32(w), 76, rgb(13, 18, 26))
	fill(mem, 0, 75, int32(w), 76, rgb(35, 42, 52))

	// Brand mark
	roundFill(mem, 28, 18, 68, 58, 20, rgb(25, 33, 45))
	roundStroke(mem, 28, 18, 68, 58, 20, rgb(204, 168, 85), 1)
	text(mem, "$", 35, 20, 61, 55, 18, FW_BOLD, rgb(229, 197, 118), DT_CENTER|DT_VCENTER|DT_SINGLELINE, "Segoe UI")
	text(mem, "MX DOLLAR", 82, 18, 300, 43, 18, FW_BOLD, rgb(245, 247, 250), DT_LEFT|DT_VCENTER|DT_SINGLELINE, "Segoe UI")
	text(mem, "IRAQ MARKET WATCH", 82, 43, 300, 61, 9, FW_SEMIBOLD, rgb(125, 137, 153), DT_LEFT|DT_VCENTER|DT_SINGLELINE, "Segoe UI")

	// LIVE pill
	roundFill(mem, 554, 24, 642, 52, 14, rgb(19, 43, 35))
	circle(mem, 568, 38, 4, rgb(75, 209, 151))
	text(mem, "LIVE", 580, 25, 630, 51, 9, FW_BOLD, rgb(103, 224, 168), DT_CENTER|DT_VCENTER|DT_SINGLELINE, "Segoe UI")
	// Min / Close
	roundFill(mem, 660, 18, 700, 54, 12, rgb(20, 27, 37))
	text(mem, "—", 660, 18, 700, 51, 13, FW_SEMIBOLD, rgb(166, 176, 188), DT_CENTER|DT_VCENTER|DT_SINGLELINE, "Segoe UI")
	roundFill(mem, 706, 18, 742, 54, 12, rgb(20, 27, 37))
	text(mem, "×", 706, 18, 742, 52, 16, FW_NORMAL, rgb(166, 176, 188), DT_CENTER|DT_VCENTER|DT_SINGLELINE, "Segoe UI")

	mu.RLock()
	d := data
	isRefreshing := refreshing
	uStatus := updateStatus
	uAvail := updateAvailable
	uInfo := updateInfo
	uBusy := updatingApp
	mu.RUnlock()
	highSell := maxInt(d.Kifah.Sell, d.Harithiya.Sell)
	highBuy := maxInt(d.Kifah.Buy, d.Harithiya.Buy)

	// Hero USD card
	roundFill(mem, 28, 98, 732, 282, 24, rgb(16, 22, 31))
	roundStroke(mem, 28, 98, 732, 282, 24, rgb(43, 52, 65), 1)
	// accent slab
	roundFill(mem, 28, 98, 38, 282, 6, rgb(89, 181, 255))
	text(mem, "USD / IQD", 55, 118, 250, 146, 11, FW_BOLD, rgb(131, 192, 247), DT_LEFT|DT_VCENTER|DT_SINGLELINE, "Segoe UI")
	text(mem, "السعر الأعلى الآن لكل 100$", 55, 146, 340, 175, 12, FW_SEMIBOLD, rgb(172, 181, 193), DT_LEFT|DT_VCENTER|DT_SINGLELINE|DT_RTLREADING, "Segoe UI")

	price := "—"
	if highSell > 0 {
		price = fmtIQD(highSell)
	}
	text(mem, price, 55, 171, 410, 234, 34, FW_BOLD, rgb(248, 250, 252), DT_LEFT|DT_VCENTER|DT_SINGLELINE, "Segoe UI")
	text(mem, "د.ع", 407, 185, 468, 226, 12, FW_BOLD, rgb(136, 148, 163), DT_LEFT|DT_VCENTER|DT_SINGLELINE|DT_RTLREADING, "Segoe UI")

	// buy/sell chips
	roundFill(mem, 500, 125, 697, 178, 15, rgb(18, 37, 31))
	text(mem, "شراء", 520, 130, 585, 173, 10, FW_SEMIBOLD, rgb(103, 224, 168), DT_LEFT|DT_VCENTER|DT_SINGLELINE|DT_RTLREADING, "Segoe UI")
	btxt := "—"
	if highBuy > 0 {
		btxt = fmtIQD(highBuy)
	}
	text(mem, btxt, 585, 130, 680, 173, 13, FW_BOLD, rgb(230, 238, 234), DT_RIGHT|DT_VCENTER|DT_SINGLELINE, "Segoe UI")
	roundFill(mem, 500, 190, 697, 243, 15, rgb(42, 31, 25))
	text(mem, "بيع", 520, 195, 585, 238, 10, FW_SEMIBOLD, rgb(241, 180, 111), DT_LEFT|DT_VCENTER|DT_SINGLELINE|DT_RTLREADING, "Segoe UI")
	stxt := "—"
	if highSell > 0 {
		stxt = fmtIQD(highSell)
	}
	text(mem, stxt, 585, 195, 680, 238, 13, FW_BOLD, rgb(246, 236, 224), DT_RIGHT|DT_VCENTER|DT_SINGLELINE, "Segoe UI")

	// Baghdad exchange cards — keep only Kifah and Harithiya.
	sourceCard(mem, 28, 302, 371, 399, "بورصة الكفاح", "KIFAH", d.Kifah)
	sourceCard(mem, 389, 302, 732, 399, "بورصة الحارثية", "HARITHIYA", d.Harithiya)

	// Gold header
	text(mem, "GOLD · الذهب", 28, 424, 320, 454, 13, FW_BOLD, rgb(229, 197, 118), DT_LEFT|DT_VCENTER|DT_SINGLELINE|DT_RTLREADING, "Segoe UI")
	text(mem, "سعر المثقال · 5 غرام", 440, 424, 732, 454, 10, FW_SEMIBOLD, rgb(125, 137, 153), DT_RIGHT|DT_VCENTER|DT_SINGLELINE|DT_RTLREADING, "Segoe UI")
	goldCard(mem, 28, 466, 248, 586, "18K", "عيار 18", d.Gold.K18)
	goldCard(mem, 270, 466, 490, 586, "21K", "عيار 21", d.Gold.K21)
	goldCard(mem, 512, 466, 732, 586, "24K", "عيار 24", d.Gold.K24)

	// Footer controls
	roundFill(mem, 28, 610, 732, 682, 20, rgb(13, 18, 26))

	upd := "بانتظار التحديث"
	if !d.Updated.IsZero() {
		upd = "آخر تحديث  " + d.Updated.Format("03:04:05 PM")
	}
	text(mem, upd, 38, 617, 532, 646, 9, FW_SEMIBOLD, rgb(118, 130, 146), DT_CENTER|DT_VCENTER|DT_SINGLELINE|DT_RTLREADING, "Segoe UI")
	text(mem, "MazenmiX", 38, 644, 532, 672, 10, FW_BOLD, rgb(229, 197, 118), DT_CENTER|DT_VCENTER|DT_SINGLELINE, "Segoe UI")

	btnColor := rgb(36, 112, 168)
	btnText := "تحديث الأسعار"
	if isRefreshing {
		btnColor = rgb(31, 73, 104)
		btnText = "جارِ التحديث..."
	}
	roundFill(mem, 545, 624, 722, 670, 14, btnColor)
	text(mem, btnText, 552, 625, 714, 669, 10, FW_BOLD, rgb(245, 249, 252), DT_CENTER|DT_VCENTER|DT_SINGLELINE|DT_RTLREADING, "Segoe UI")

	if d.Error != "" {
		text(mem, "آخر تحديث استخدم بيانات محفوظة", 28, 683, 732, 702, 8, FW_SEMIBOLD, rgb(211, 157, 91), DT_CENTER|DT_VCENTER|DT_SINGLELINE|DT_RTLREADING, "Segoe UI")
	}

	// App update strip. A green action appears only when a newer version exists.
	roundFill(mem, 28, 708, 732, 746, 14, rgb(14, 20, 28))
	roundStroke(mem, 28, 708, 732, 746, 14, rgb(36, 46, 59), 1)
	statusText := fmt.Sprintf("MX Dollar v%s · %s", appVersion, uStatus)
	statusColor := rgb(132, 145, 161)
	if uAvail {
		statusText = fmt.Sprintf("تحديث v%s متوفر", uInfo.Version)
		statusColor = rgb(103, 224, 168)
	}
	if uBusy {
		statusText = "جاري تنزيل وتجهيز التحديث..."
		statusColor = rgb(131, 192, 247)
	}
	if uAvail || uBusy {
		text(mem, statusText, 42, 711, 550, 743, 9, FW_SEMIBOLD, statusColor, DT_CENTER|DT_VCENTER|DT_SINGLELINE|DT_RTLREADING, "Segoe UI")
		btn := "حدّث الآن"
		bc := rgb(29, 118, 82)
		if uBusy {
			btn = "جاري التحديث..."
			bc = rgb(31, 73, 61)
		}
		roundFill(mem, 570, 711, 720, 743, 12, bc)
		text(mem, btn, 575, 711, 715, 743, 9, FW_BOLD, rgb(244, 250, 247), DT_CENTER|DT_VCENTER|DT_SINGLELINE|DT_RTLREADING, "Segoe UI")
	} else {
		text(mem, statusText, 42, 711, 718, 743, 9, FW_SEMIBOLD, statusColor, DT_CENTER|DT_VCENTER|DT_SINGLELINE|DT_RTLREADING, "Segoe UI")
	}

	procBitBlt.Call(hdc, 0, 0, uintptr(w), uintptr(hh), mem, 0, 0, SRCCOPY)
}

func sourceCard(hdc uintptr, l, t, r, b int32, arName, code string, q Quote) {
	roundFill(hdc, l, t, r, b, 18, rgb(15, 21, 30))
	roundStroke(hdc, l, t, r, b, 18, rgb(37, 46, 58), 1)
	text(hdc, code, l+20, t+14, l+100, t+38, 9, FW_BOLD, rgb(104, 178, 236), DT_LEFT|DT_VCENTER|DT_SINGLELINE, "Segoe UI")
	text(hdc, arName, l+108, t+12, r-18, t+40, 10, FW_SEMIBOLD, rgb(185, 194, 205), DT_RIGHT|DT_VCENTER|DT_SINGLELINE|DT_RTLREADING, "Segoe UI")
	sell := "—"
	buy := "—"
	if q.Sell > 0 {
		sell = fmtIQD(q.Sell)
	}
	if q.Buy > 0 {
		buy = fmtIQD(q.Buy)
	}
	text(hdc, "بيع", l+20, t+49, l+65, t+78, 9, FW_SEMIBOLD, rgb(220, 160, 98), DT_LEFT|DT_VCENTER|DT_SINGLELINE|DT_RTLREADING, "Segoe UI")
	text(hdc, sell, l+70, t+48, l+160, t+78, 13, FW_BOLD, rgb(242, 245, 248), DT_LEFT|DT_VCENTER|DT_SINGLELINE, "Segoe UI")
	text(hdc, "شراء", l+190, t+49, l+243, t+78, 9, FW_SEMIBOLD, rgb(91, 204, 148), DT_LEFT|DT_VCENTER|DT_SINGLELINE|DT_RTLREADING, "Segoe UI")
	text(hdc, buy, l+245, t+48, r-18, t+78, 13, FW_BOLD, rgb(242, 245, 248), DT_RIGHT|DT_VCENTER|DT_SINGLELINE, "Segoe UI")
}

func goldCard(hdc uintptr, l, t, r, b int32, code, ar string, val int) {
	roundFill(hdc, l, t, r, b, 18, rgb(18, 22, 28))
	roundStroke(hdc, l, t, r, b, 18, rgb(59, 52, 37), 1)
	roundFill(hdc, l+16, t+15, l+69, t+43, 14, rgb(48, 40, 24))
	text(hdc, code, l+16, t+15, l+69, t+43, 9, FW_BOLD, rgb(229, 197, 118), DT_CENTER|DT_VCENTER|DT_SINGLELINE, "Segoe UI")
	text(hdc, ar, l+82, t+15, r-15, t+43, 9, FW_SEMIBOLD, rgb(151, 160, 172), DT_RIGHT|DT_VCENTER|DT_SINGLELINE|DT_RTLREADING, "Segoe UI")
	s := "—"
	if val > 0 {
		s = fmtIQD(val)
	}
	text(hdc, s, l+16, t+55, r-16, t+95, 18, FW_BOLD, rgb(246, 242, 230), DT_CENTER|DT_VCENTER|DT_SINGLELINE, "Segoe UI")
	text(hdc, "د.ع", l+16, t+93, r-16, t+112, 8, FW_SEMIBOLD, rgb(124, 115, 91), DT_CENTER|DT_VCENTER|DT_SINGLELINE|DT_RTLREADING, "Segoe UI")
}

func fill(hdc uintptr, l, t, r, b int32, color uintptr) {
	br, _, _ := procCreateSolidBrush.Call(color)
	rc := RECT{l, t, r, b}
	procFillRect.Call(hdc, uintptr(unsafe.Pointer(&rc)), br)
	procDeleteObject.Call(br)
}
func roundFill(hdc uintptr, l, t, r, b, rad int32, color uintptr) {
	br, _, _ := procCreateSolidBrush.Call(color)
	old, _, _ := procSelectObject.Call(hdc, br)
	pen, _, _ := procCreatePen.Call(PS_SOLID, 1, color)
	oldp, _, _ := procSelectObject.Call(hdc, pen)
	procRoundRect.Call(hdc, uintptr(l), uintptr(t), uintptr(r), uintptr(b), uintptr(rad), uintptr(rad))
	procSelectObject.Call(hdc, old)
	procSelectObject.Call(hdc, oldp)
	procDeleteObject.Call(br)
	procDeleteObject.Call(pen)
}
func roundStroke(hdc uintptr, l, t, r, b, rad int32, color uintptr, width int32) {
	pen, _, _ := procCreatePen.Call(PS_SOLID, uintptr(width), color)
	oldp, _, _ := procSelectObject.Call(hdc, pen)
	hollow, _, _ := procGetStockObject.Call(5) // HOLLOW_BRUSH
	oldb, _, _ := procSelectObject.Call(hdc, hollow)
	procRoundRect.Call(hdc, uintptr(l), uintptr(t), uintptr(r), uintptr(b), uintptr(rad), uintptr(rad))
	procSelectObject.Call(hdc, oldb)
	procSelectObject.Call(hdc, oldp)
	procDeleteObject.Call(pen)
}
func circle(hdc uintptr, cx, cy, rad int32, color uintptr) {
	roundFill(hdc, cx-rad, cy-rad, cx+rad, cy+rad, rad*2, color)
}

func text(hdc uintptr, s string, l, t, r, b int32, size int32, weight int32, color uintptr, flags uint32, face string) {
	if s == "" || r <= l || b <= t {
