<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MX FIELD TRACKER"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/topState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFF SHIFT"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Track • Work • Secure  |  By MazenmiX"
            android:textColor="#59A8FF"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/liveCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/statusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● OFF SHIFT"
                android:textColor="@color/muted"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Enter your name, complete the readiness check, then start your shift."
                android:textColor="@color/text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/shiftMetrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Shift time —   •   Locations 0   •   Distance 0.00 km"
                android:textColor="#9FB0C4"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/readinessCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_warning"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/readinessTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠ TRACKING READINESS"
                android:textColor="#FFD35A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/locationState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="○ Location permission"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/backgroundState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="○ Background location"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/gpsState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="○ GPS / Location service"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/notificationState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="○ Notifications"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/batteryState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="○ Battery / background protection"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/fixSettingsButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_warning_button"
                android:text="FIX / OPEN REQUIRED SETTINGS"
                android:textColor="#191200"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="YOUR NAME"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/employeeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Enter your full name"
            android:inputType="textPersonName|textCapWords"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="#5F6B7A" />

        <TextView
            android:id="@+id/employeeCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Device not registered yet"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_start"
            android:text="START SHIFT"
            android:textColor="#04130A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_stop"
            android:text="END SHIFT"
            android:textColor="#1A0608"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/appSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_secondary"
            android:text="APP / BATTERY SETTINGS"
            android:textColor="@color/text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/updateButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_secondary"
            android:text="CHECK FOR UPDATE"
            android:textColor="@color/text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/updateState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="App version 1.2.0 • Update status not checked yet"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/lastSent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Last location upload: —"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/summaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:text="Latest shift summary will appear here after End Shift."
            android:textColor="#9FB0C4"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:text="Location is shared only during an active work shift. Android displays a persistent tracking notification."
            android:textColor="#667384"
            android:textSize="10sp" />

    </LinearLayout>
</ScrollView>